# Public browser configuration for the secure account-deletion page.
# Use the same Supabase project as the OneBill app. The anon key is designed
# for client use; never put SUPABASE_SERVICE_ROLE_KEY or any private secret here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
